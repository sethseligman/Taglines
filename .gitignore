# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Hint generator local resume state
scripts/HINT GENERATOR/taglines_progress.json
scripts/HINT GENERATOR/taglines_progress_block*.json
taglines_progress_block*.json

# Hint generator artifacts
scripts/HINT GENERATOR/*.csv
scripts/HINT GENERATOR/*.log
taglines_hints_output*.csv

# Hint generator test / backup outputs (keep block*.csv in repo root if committed)
scripts/HINT GENERATOR/taglines_hints_output_*_TEST*.csv
scripts/HINT GENERATOR/taglines_hints_output_*_NOCRITIC.csv
scripts/HINT GENERATOR/taglines_hints_output_BACKUP.csv

# Supabase temp
supabase/.temp/

# Skills
skills-lock.json

# Legacy files
*.old.ts

# Local data files
src/data/*.xlsx

# Excel lock files
~$*

# Local agent tooling
.agents/
.claude/
