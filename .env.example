# Supabase (required for DB-backed movies and admin)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin: password to access /admin (min 8 chars). No key = admin disabled.
ADMIN_SECRET=your-admin-password

# Optional: canonical URL in share text when not in a browser (defaults to https://taglines.app)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional: Hint generator script (not used by the Next.js app). Provider: anthropic (default) or openai.
# HINT_GEN_PROVIDER=openai
# HINT_GEN_BATCH_SIZE=5
# HINT_GEN_COOLDOWN_MS=12000
# HINT_GEN_SKIP_CRITIC=1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
